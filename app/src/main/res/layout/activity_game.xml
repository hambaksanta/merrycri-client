<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/activity_game.xml · 선물 벽돌깨기. 담당: C -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="@dimen/space_12"
        android:layout_marginTop="@dimen/space_16"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/exit_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_4"
            android:text="@string/game_exit_symbol"
            android:contentDescription="@string/game_exit"
            android:textColor="@color/white"
            android:textAppearance="@style/TextAppearance.MerryCri.Subtitle"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/time_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:gravity="start"
            android:textColor="@color/white"
            android:textAppearance="@style/TextAppearance.MerryCri.Subtitle"
            tools:text="52초"
            app:layout_constraintStart_toEndOf="@id/exit_button"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/score_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/gold"
            android:textAppearance="@style/TextAppearance.MerryCri.Subtitle"
            tools:text="0점"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/lives_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/berry_light"
            android:textAppearance="@style/TextAppearance.MerryCri.Subtitle"
            tools:text="♥ ♥ ♥"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 남은 시간을 모래시계 아이콘 + 줄어드는 막대로 보여주는 구분선 겸 프로그레스바. 선물(벽돌) 영역과 상단 HUD 사이에 위치. -->
    <TextView
        android:id="@+id/time_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:text="@string/game_time_icon"
        android:textColor="@color/gold"
        android:textAppearance="@style/TextAppearance.MerryCri.Subtitle"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/time_progress"
        app:layout_constraintBottom_toBottomOf="@id/time_progress" />

    <ProgressBar
        android:id="@+id/time_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginTop="@dimen/space_8"
        android:max="60"
        android:progress="60"
        android:progressTint="@color/gold"
        android:progressBackgroundTint="@color/night_text_muted"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/time_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <com.hambaksanta.merrycri.ui.game.BreakoutView
        android:id="@+id/breakout_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/time_progress"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/score_popup_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/gold"
        android:textAppearance="@style/TextAppearance.MerryCri.Title"
        android:alpha="0"
        android:visibility="visible"
        tools:text="+30"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/time_progress" />

    <!-- 1단계: 흰(크림) 화면 — 친구 트리 전체 순위 + 하단 '게임 시작하기'. 게임이 끝나고 돌아오는 화면이기도 하다. 담당: C -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rank_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/cream"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="@dimen/space_20"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rank_back_button"
            style="@style/Widget.MerryCri.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingVertical="@dimen/space_8"
            android:text="@string/game_back_button"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/rank_top_divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_20"
            android:background="@color/line"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rank_back_button" />

        <TextView
            android:id="@+id/rank_board_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:text="@string/leaderboard_list_label"
            android:textColor="@color/ink"
            android:textAppearance="@style/TextAppearance.MerryCri.Subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rank_top_divider" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rank_score_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_8"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_16"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/rank_play_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rank_board_label" />

        <TextView
            android:id="@+id/rank_board_empty_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:gravity="center"
            android:text="@string/leaderboard_empty"
            android:textColor="@color/ink_muted"
            android:textAppearance="@style/TextAppearance.MerryCri.Body"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/rank_play_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rank_board_label" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rank_play_button"
            style="@style/Widget.MerryCri.Button.Accent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_20"
            android:minHeight="64dp"
            android:textSize="19sp"
            android:text="@string/game_start_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2단계: 게임 설명 화면. rank_overlay에서 '게임 시작하기'를 누르면 여기로 오고,
         여기를 탭하면 실제로 공이 움직이기 시작한다. owner가 없는 연습 모드는 처음부터 바로 여기. 담당: C -->
    <LinearLayout
        android:id="@+id/start_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#E614213D"
        android:padding="@dimen/space_24"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/game_title"
            android:textColor="@color/white"
            android:textAppearance="@style/TextAppearance.MerryCri.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:gravity="center"
            android:text="@string/game_rules"
            android:textColor="@color/night_text_muted"
            android:textAppearance="@style/TextAppearance.MerryCri.Body" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/game_tap_to_start"
            android:textColor="@color/gold"
            android:textAppearance="@style/TextAppearance.MerryCri.Subtitle" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/result_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/cream"
        android:padding="@dimen/space_24"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/result_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/game_over_title"
            android:textColor="@color/ink"
            android:textAppearance="@style/TextAppearance.MerryCri.Title" />

        <TextView
            android:id="@+id/result_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:textColor="@color/pine"
            android:textAppearance="@style/TextAppearance.MerryCri.Display"
            tools:text="130점" />

        <TextView
            android:id="@+id/result_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textColor="@color/ink_muted"
            android:textAppearance="@style/TextAppearance.MerryCri.Body"
            android:visibility="gone"
            tools:text="@string/game_new_best" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retry_button"
            style="@style/Widget.MerryCri.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/game_play_again" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/close_button"
            style="@style/Widget.MerryCri.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:textColor="@color/ink"
            android:text="@string/game_close" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
