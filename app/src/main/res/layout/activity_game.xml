<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/activity_game.xml · 선물 벽돌깨기. 담당: C -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="@dimen/space_12"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/exit_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_12"
            android:padding="@dimen/space_4"
            android:text="@string/game_exit_symbol"
            android:contentDescription="@string/game_exit"
            android:textColor="@color/white"
            android:textAppearance="@style/TextAppearance.MerryCri.Subtitle"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/time_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:textColor="@color/white"
            android:textAppearance="@style/TextAppearance.MerryCri.Subtitle"
            tools:text="⏱ 0:60" />

        <TextView
            android:id="@+id/lives_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/berry_light"
            android:textAppearance="@style/TextAppearance.MerryCri.Subtitle"
            tools:text="♥ ♥ ♥" />

        <TextView
            android:id="@+id/score_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/gold"
            android:textAppearance="@style/TextAppearance.MerryCri.Subtitle"
            tools:text="0점" />

    </LinearLayout>

    <com.hambaksanta.merrycri.ui.game.BreakoutView
        android:id="@+id/breakout_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toBottomOf="parent" />

    <LinearLayout
        android:id="@+id/start_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC14213D"
        android:padding="@dimen/space_24"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/game_title"
            android:textColor="@color/white"
            android:textAppearance="@style/TextAppearance.MerryCri.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:gravity="center"
            android:text="@string/game_rules"
            android:textColor="@color/night_text_muted"
            android:textAppearance="@style/TextAppearance.MerryCri.Body" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/game_tap_to_start"
            android:textColor="@color/gold"
            android:textAppearance="@style/TextAppearance.MerryCri.Subtitle" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/result_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC14213D"
        android:padding="@dimen/space_24"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/result_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/game_over_title"
            android:textColor="@color/white"
            android:textAppearance="@style/TextAppearance.MerryCri.Title" />

        <TextView
            android:id="@+id/result_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:textColor="@color/gold"
            android:textAppearance="@style/TextAppearance.MerryCri.Display"
            tools:text="130점" />

        <TextView
            android:id="@+id/result_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textColor="@color/night_text_muted"
            android:textAppearance="@style/TextAppearance.MerryCri.Body"
            android:visibility="gone"
            tools:text="@string/game_new_best" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retry_button"
            style="@style/Widget.MerryCri.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/game_play_again" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/close_button"
            style="@style/Widget.MerryCri.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:textColor="@color/ink"
            android:text="@string/game_close" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
