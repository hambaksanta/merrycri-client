<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/item_friend.xml · 친구 목록 한 줄 (아바타 · 닉네임 · 그 친구 트리의 1등 점수) · 담당: C -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/friend_card"
    style="@style/Widget.MerryCri.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_padding"
    android:layout_marginTop="@dimen/space_12"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true"
    app:rippleColor="@color/pine_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/space_12">

        <TextView
            android:id="@+id/avatar_text"
            android:layout_width="@dimen/avatar_size"
            android:layout_height="@dimen/avatar_size"
            android:background="@drawable/bg_avatar_circle"
            android:gravity="center"
            android:textColor="@color/white"
            android:textAppearance="@style/TextAppearance.MerryCri.Subtitle"
            tools:text="지" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_12"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nickname_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textAppearance="@style/TextAppearance.MerryCri.Subtitle"
                tools:text="박지우" />

            <TextView
                android:id="@+id/top_score_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/ink_muted"
                android:textAppearance="@style/TextAppearance.MerryCri.Caption"
                tools:text="🏆 조온유님 150점" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="@color/ink_muted"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
