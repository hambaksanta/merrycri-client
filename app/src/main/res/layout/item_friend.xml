<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/item_friend.xml · 친구 목록 한 줄 (트리 썸네일 · 닉네임/코드 · 1등 점수 · 트리 단계 · 편지 상태). 담당: B(목록) · C(1등 점수) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.MerryCri.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_16">

        <ImageView
            android:id="@+id/friend_tree_image"
            android:layout_width="@dimen/friend_tree_width"
            android:layout_height="@dimen/friend_tree_height"
            android:contentDescription="@string/friends_tree_image_description"
            android:scaleType="fitCenter"
            android:src="@drawable/tree_lv1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/friend_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.MerryCri.Subtitle"
                tools:text="박지우" />

            <TextView
                android:id="@+id/friend_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.MerryCri.Caption"
                tools:text="코드 AB12CD" />

            <!-- 그 친구 트리에서 지금까지 나온 미니게임 1등 점수. 담당: C -->
            <TextView
                android:id="@+id/top_score_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/ink_muted"
                android:textAppearance="@style/TextAppearance.MerryCri.Caption"
                tools:text="🏆 조온유님 150점" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="top"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/friend_tree_stage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.MerryCri.Caption" />

                <!-- 편지는 하루 한 통. 오늘 이미 썼으면 status_done, 아니면 status_todo(클릭해서 쓰기). 게임 버튼과 함께 오른쪽 정렬. 담당: C -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/status_done"
                        style="@style/Widget.MerryCri.Chip.Done"
                        android:text="@string/friends_letter_done"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/status_todo"
                        style="@style/Widget.MerryCri.Chip.Todo"
                        android:text="@string/friends_letter_todo" />

                    <!-- 카드(root) 전체를 누르면 친구 트리 구경 화면으로 가고, 게임은 이 버튼으로만 이동한다. 담당: C -->
                    <TextView
                        android:id="@+id/play_game_button"
                        style="@style/Widget.MerryCri.Chip.Game"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/friends_play_game" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
