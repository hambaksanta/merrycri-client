<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/fragment_letter_write.xml -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:padding="@dimen/screen_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <!-- 게임 화면의 '← 뒤로가기'와 같은 패턴. 친구 목록에서 들어온 화면이라 항상 친구 목록으로 돌아간다. 담당: C -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/back_button"
            style="@style/Widget.MerryCri.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingVertical="@dimen/space_8"
            android:text="@string/letter_write_back_button"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/letter_write_title"
            android:textAppearance="@style/TextAppearance.MerryCri.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/letter_write_hint"
            android:textAppearance="@style/TextAppearance.MerryCri.Body" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/recipient_input_layout"
            style="@style/Widget.MerryCri.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:hint="@string/letter_write_recipient_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/recipient_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:maxLength="6" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/letter_input_layout"
            style="@style/Widget.MerryCri.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            app:counterEnabled="true"
            app:counterMaxLength="300">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/letter_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="300"
                android:minLines="6" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/letter_write_ornament_label"
            android:textAppearance="@style/TextAppearance.MerryCri.Subtitle" />

        <LinearLayout
            android:id="@+id/ornament_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ornament_bauble"
                android:layout_width="@dimen/ornament_picker_size"
                android:layout_height="@dimen/ornament_picker_size"
                android:background="@drawable/bg_ornament_picker"
                android:clickable="true"
                android:contentDescription="@string/ornament_bauble"
                android:focusable="true"
                android:padding="@dimen/space_4"
                android:src="@drawable/orn_bauble" />

            <ImageView
                android:id="@+id/ornament_star"
                android:layout_width="@dimen/ornament_picker_size"
                android:layout_height="@dimen/ornament_picker_size"
                android:layout_marginStart="@dimen/space_12"
                android:background="@drawable/bg_ornament_picker"
                android:clickable="true"
                android:contentDescription="@string/ornament_star"
                android:focusable="true"
                android:padding="@dimen/space_4"
                android:src="@drawable/orn_star" />

            <ImageView
                android:id="@+id/ornament_cane"
                android:layout_width="@dimen/ornament_picker_size"
                android:layout_height="@dimen/ornament_picker_size"
                android:layout_marginStart="@dimen/space_12"
                android:background="@drawable/bg_ornament_picker"
                android:clickable="true"
                android:contentDescription="@string/ornament_cane"
                android:focusable="true"
                android:padding="@dimen/space_4"
                android:src="@drawable/orn_cane" />

            <ImageView
                android:id="@+id/ornament_snow"
                android:layout_width="@dimen/ornament_picker_size"
                android:layout_height="@dimen/ornament_picker_size"
                android:layout_marginStart="@dimen/space_12"
                android:background="@drawable/bg_ornament_picker"
                android:clickable="true"
                android:contentDescription="@string/ornament_snow"
                android:focusable="true"
                android:padding="@dimen/space_4"
                android:src="@drawable/orn_snow" />

            <ImageView
                android:id="@+id/ornament_gift"
                android:layout_width="@dimen/ornament_picker_size"
                android:layout_height="@dimen/ornament_picker_size"
                android:layout_marginStart="@dimen/space_12"
                android:background="@drawable/bg_ornament_picker"
                android:clickable="true"
                android:contentDescription="@string/ornament_gift"
                android:focusable="true"
                android:padding="@dimen/space_4"
                android:src="@drawable/orn_gift" />

            <ImageView
                android:id="@+id/ornament_bell"
                android:layout_width="@dimen/ornament_picker_size"
                android:layout_height="@dimen/ornament_picker_size"
                android:layout_marginStart="@dimen/space_12"
                android:background="@drawable/bg_ornament_picker"
                android:clickable="true"
                android:contentDescription="@string/ornament_bell"
                android:focusable="true"
                android:padding="@dimen/space_4"
                android:src="@drawable/orn_bell" />
        </LinearLayout>

        <TextView
            android:id="@+id/ornament_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/letter_write_error_ornament"
            android:textAppearance="@style/TextAppearance.MerryCri.Caption"
            android:textColor="@color/berry"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_button"
            style="@style/Widget.MerryCri.Button.Accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:enabled="false"
            android:text="@string/letter_write_save" />
    </LinearLayout>

</FrameLayout>
