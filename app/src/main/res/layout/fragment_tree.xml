<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/fragment_tree.xml · 내 트리 홈 · 담당: A
     트리 장면 + 내 친구 코드 카드(보여주기·복사·공유). 상단 D-day·진행바·버튼은 "홈 화면 조립" 작업에서 붙인다. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="@dimen/radius_tree"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <com.hambaksanta.merrycri.ui.tree.TreeSceneView
                android:id="@+id/tree_scene"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/text_stage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.MerryCri.Subtitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tree_demo_hint"
            android:textAppearance="@style/TextAppearance.MerryCri.Caption" />

        <!-- 내 친구 코드: 코드를 누르거나 [복사]로 복사, [공유]로 메신저에 보내기. 코드가 없으면(가입 전) 숨김 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_my_code"
            style="@style/Widget.MerryCri.Card.Highlight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_20">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/my_code_label"
                    android:textAppearance="@style/TextAppearance.MerryCri.Caption"
                    android:textColor="@color/pine_light" />

                <TextView
                    android:id="@+id/text_my_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:background="?attr/selectableItemBackground"
                    android:letterSpacing="0.18"
                    android:textAppearance="@style/TextAppearance.MerryCri.Display"
                    android:textColor="@color/white"
                    android:textIsSelectable="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/my_code_hint"
                    android:textAppearance="@style/TextAppearance.MerryCri.Caption"
                    android:textColor="@color/pine_light" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_copy_code"
                        style="@style/Widget.MerryCri.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_8"
                        android:layout_weight="1"
                        android:text="@string/my_code_copy"
                        app:icon="@drawable/ic_copy"
                        app:iconGravity="textStart"
                        app:strokeWidth="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_share_code"
                        style="@style/Widget.MerryCri.Button.Accent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:layout_weight="1"
                        android:minHeight="@dimen/button_height"
                        android:text="@string/my_code_share"
                        app:icon="@drawable/ic_share"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
