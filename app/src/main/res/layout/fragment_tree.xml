<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/fragment_tree.xml · 내 트리 홈 · 담당: A
     첫 화면처럼 하늘이 화면을 꽉 채우고, 트리 밑동이 하늘 그림의 땅에 닿게 놓는다(TreeFragment.alignToGround).
     위: 타이틀 · D-day · 단계 · 다음 단계까지 진행바 / 아래: 받은 편지 버튼.
     우체통이나 트리의 장식을 눌러도 편지를 볼 수 있다. 편지 내용은 12/25(config/openAt) 이후에만 열린다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_tree"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sky_lv1">

    <ImageView
        android:id="@+id/image_sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        tools:src="@drawable/bg_sky_lv3" />

    <com.hambaksanta.merrycri.ui.tree.AuroraView
        android:id="@+id/aurora"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.hambaksanta.merrycri.ui.tree.WeatherView
        android:id="@+id/weather"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 트리·소품·우체통·장식. 하늘은 위에서 따로 깔고 여기서는 숨긴다 -->
    <com.hambaksanta.merrycri.ui.tree.TreeSceneView
        android:id="@+id/tree_scene"
        android:layout_width="340dp"
        android:layout_height="404dp"
        android:layout_gravity="center"
        android:contentDescription="@string/intro_cd_my_tree" />

    <!-- 왼쪽 위 D-day (오른쪽 위 [순위]와 같은 높이) -->
    <TextView
        android:id="@+id/text_dday"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_intro_dday"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:textAppearance="@style/TextAppearance.MerryCri.Label"
        android:textColor="@color/ink"
        android:textSize="13sp"
        tools:text="크리스마스까지 D-30" />

    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="76dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- 내 이름: '지우님의 트리' (가입할 때 저장된 닉네임) -->
        <TextView
            android:id="@+id/text_owner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.MerryCri.Title"
            tools:text="지우님의 트리" />

        <TextView
            android:id="@+id/text_stage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.MerryCri.Subtitle"
            tools:text="Lv2 새싹 트리" />

        <TextView
            android:id="@+id/text_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.MerryCri.Caption"
            tools:text="조금 따뜻해졌어요" />

        <!-- 다음 단계까지: 진행바 위에 남은 통수. Lv5면 진행바는 숨기고 문구만 -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_stage"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:max="100"
            app:indicatorColor="@color/gold"
            app:indicatorTrackGapSize="0dp"
            app:trackColor="#331E2A28"
            app:trackCornerRadius="4dp"
            app:trackStopIndicatorSize="0dp"
            app:trackThickness="8dp"
            tools:progress="50" />

        <TextView
            android:id="@+id/text_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.MerryCri.Label"
            tools:text="2통 더 받으면 다음 단계" />
    </LinearLayout>

    <!-- 내 트리 미니게임 순위 팝업 (#50). 친구들이 내 트리에서 낸 최고점 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_ranking"
        style="@style/Widget.MerryCri.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:minHeight="40dp"
        android:paddingHorizontal="14dp"
        android:text="@string/tree_ranking_button"
        android:textSize="13sp"
        app:strokeWidth="0dp" />

    <!-- 받은 편지 보기. 12/25 전에는 잠금 안내, 이후에는 편지 목록 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_letters"
        style="@style/Widget.MerryCri.Button.Accent"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/button_height"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:minHeight="@dimen/button_height"
        android:paddingHorizontal="28dp"
        tools:text="📬 받은 편지 4통" />

</FrameLayout>
