<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/bg_ornament_picker.xml · 편지 쓰기 장식 고르기 선택 표시 · 담당: C -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/pine_light" />
            <stroke
                android:width="2dp"
                android:color="@color/pine" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/card" />
            <stroke
                android:width="1dp"
                android:color="@color/line" />
        </shape>
    </item>
</selector>
