        android:name="com.hambaksanta.merrycri.ui.letter.WriteFragment"
        android:label="@string/placeholder_letter_write" />

    <fragment
        android:id="@+id/openLettersFragment"
        android:name="com.hambaksanta.merrycri.ui.letter.OpenLettersFragment"
        android:label="@string/placeholder_letter_read" />

    <fragment
