    app:startDestination="@id/navigation_tree">

    <fragment
        android:id="@+id/navigation_tree"
        android:name="com.hambaksanta.merrycri.ui.tree.TreeFragment"
        android:label="@string/tab_tree" />

    <fragment
        android:id="@+id/navigation_friends"
        android:name="com.hambaksanta.merrycri.ui.friends.FriendsFragment"
        android:label="@string/tab_friends" />

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.hambaksanta.merrycri.ui.onboarding.OnboardingFragment"
