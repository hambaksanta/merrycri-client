<?xml version="1.0" encoding="utf-8"?>
<!-- res/navigation/nav_graph.xml -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/onboardingFragment">

    <!-- 앱 첫 화면 (담당: A). MainActivity가 앱을 처음 켤 때 시작 화면(온보딩) 위에 한 번 띄우고,
         끝나면 popBackStack()으로 닫는다. 그 다음 길(홈/닉네임 입력)은 온보딩이 정한다. -->
    <fragment
        android:id="@+id/introFragment"
        android:name="com.hambaksanta.merrycri.ui.intro.IntroFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_intro_to_onboarding"
            app:destination="@id/onboardingFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"
            app:popUpTo="@id/introFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/navigation_tree"
        android:name="com.hambaksanta.merrycri.ui.tree.TreeFragment"
        android:label="@string/tab_tree" />

    <fragment
        android:id="@+id/navigation_friends"
        android:name="com.hambaksanta.merrycri.ui.friends.FriendsFragment"
        android:label="@string/tab_friends" />

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.hambaksanta.merrycri.ui.onboarding.OnboardingFragment"
        android:label="@string/placeholder_onboarding" />

    <fragment
        android:id="@+id/friendTreeFragment"
        android:name="com.hambaksanta.merrycri.ui.letter.FriendTreeFragment"
        android:label="@string/placeholder_friend_tree" />

    <fragment
        android:id="@+id/writeFragment"
        android:name="com.hambaksanta.merrycri.ui.letter.WriteFragment"
        android:label="@string/placeholder_letter_write" />

    <fragment
        android:id="@+id/openLettersFragment"
        android:name="com.hambaksanta.merrycri.ui.letter.OpenLettersFragment"
        android:label="@string/placeholder_letter_read" />

    <fragment
        android:id="@+id/leaderboardFragment"
        android:name="com.hambaksanta.merrycri.ui.leaderboard.LeaderboardFragment"
        android:label="@string/placeholder_leaderboard" />

</navigation>
